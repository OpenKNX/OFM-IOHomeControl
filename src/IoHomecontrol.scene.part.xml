<?xml version="1.0" encoding="utf-8"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20">

  <!-- Complete definition of the n-th io-homecontrol scene slot.
       The template inserts the Parameters into the existing channel Union,
       the ParameterRefs into the channel ParameterRefs block and the Dynamic
       snippet into the channel page. -->

  <Static>
    <Parameters>
      <!-- Scene parameter IDs are calculated from %ID%:
           %ID%      = position
           %ID+10%   = action
           %ID+20%   = slat
           %ID+30%   = thermostat temperature
           %ID+40%   = thermostat mode
           %ID+50%   = on/off state

           Scene memory offsets are calculated from %N%:
           %N+13%    = scene data 1..10  (offsets 14..23)
           %N+23%    = action/mode 1..10 (offsets 24..33)
           %N+33%    = slat 1..10        (offsets 34..43)

           The overlays are intentional because the active interpretation
           depends on the selected device type. -->
      <Parameter Id="%AID%_UP-%TT%%CC%%ID%" op:nowarn="true" Name="IOHC%C%Scene%N%Position" ParameterType="%AID%_PT-IOHCScenePosition" Offset="%N+13%" BitOffset="0" Text="Szene %N% Position" Value="0" SuffixText=" %" />
      <Parameter Id="%AID%_UP-%TT%%CC%%ID+10%" op:nowarn="true" Name="IOHC%C%Scene%N%Action" ParameterType="%AID%_PT-IOHCSceneAction" Offset="%N+23%" BitOffset="0" Text="Szene %N% Aktion" Value="0" />
      <Parameter Id="%AID%_UP-%TT%%CC%%ID+20%" op:nowarn="true" Name="IOHC%C%Scene%N%Slat" ParameterType="%AID%_PT-IOHCScenePosition" Offset="%N+33%" BitOffset="0" Text="Szene %N% Lamellenposition" Value="0" SuffixText=" %" />
      <Parameter Id="%AID%_UP-%TT%%CC%%ID+30%" op:nowarn="true" Name="IOHC%C%Scene%N%Temperature" ParameterType="%AID%_PT-IOHCSceneTemperature" Offset="%N+13%" BitOffset="0" Text="Szene %N% Temperatur" Value="20" SuffixText=" °C" />
      <Parameter Id="%AID%_UP-%TT%%CC%%ID+40%" op:nowarn="true" Name="IOHC%C%Scene%N%CozyMode" ParameterType="%AID%_PT-IOHCSceneCozyMode" Offset="%N+23%" BitOffset="0" Text="Szene %N% Modus" Value="0" />
      <Parameter Id="%AID%_UP-%TT%%CC%%ID+50%" op:nowarn="true" Name="IOHC%C%Scene%N%OnOff" ParameterType="%AID%_PT-IOHCSceneOnOff" Offset="%N+13%" BitOffset="0" Text="Szene %N% Zustand" Value="0" />
    </Parameters>

    <ParameterRefs>
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID%_R-%TT%%CC%%ID%01" RefId="%AID%_UP-%TT%%CC%%ID%" />
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID+10%_R-%TT%%CC%%ID+10%01" RefId="%AID%_UP-%TT%%CC%%ID+10%" />
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID+20%_R-%TT%%CC%%ID+20%01" RefId="%AID%_UP-%TT%%CC%%ID+20%" />
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID+30%_R-%TT%%CC%%ID+30%01" RefId="%AID%_UP-%TT%%CC%%ID+30%" />
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID+40%_R-%TT%%CC%%ID+40%01" RefId="%AID%_UP-%TT%%CC%%ID+40%" />
      <ParameterRef Id="%AID%_UP-%TT%%CC%%ID+50%_R-%TT%%CC%%ID+50%01" RefId="%AID%_UP-%TT%%CC%%ID+50%" />
    </ParameterRefs>
  </Static>

  <Dynamic>
    <choose ParamRefId="%AID%_UP-%TT%%CC%020_R-%TT%%CC%02001">
      <when test="&gt;=%N%">
        <ParameterSeparator Id="%AID%_PS-nnn" Text="Szene %N%" UIHint="Headline" />

        <choose ParamRefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201">
          <!-- Position scenes without lamella -->
          <when test="0 2 3 4 7 10 11">
            <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+10%_R-%TT%%CC%%ID+10%01" IndentLevel="2" HelpContext="IOHC-Szenenaktion" />
            <choose ParamRefId="%AID%_UP-%TT%%CC%%ID+10%_R-%TT%%CC%%ID+10%01">
              <when test="0">
                <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID%_R-%TT%%CC%%ID%01" IndentLevel="2" HelpContext="IOHC-Szenenposition" />
              </when>
            </choose>
          </when>

          <!-- Position scenes with lamella -->
          <when test="1 9">
            <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+10%_R-%TT%%CC%%ID+10%01" IndentLevel="2" HelpContext="IOHC-Szenenaktion" />
            <choose ParamRefId="%AID%_UP-%TT%%CC%%ID+10%_R-%TT%%CC%%ID+10%01">
              <when test="0">
                <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID%_R-%TT%%CC%%ID%01" IndentLevel="2" HelpContext="IOHC-Szenenposition" />
                <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+20%_R-%TT%%CC%%ID+20%01" IndentLevel="2" HelpContext="IOHC-Szenenlamelle" />
              </when>
            </choose>
          </when>

          <!-- Thermostat scenes -->
          <when test="5">
            <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+30%_R-%TT%%CC%%ID+30%01" IndentLevel="2" HelpContext="IOHC-Szenentemperatur" />
            <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+40%_R-%TT%%CC%%ID+40%01" IndentLevel="2" HelpContext="IOHC-Szenenmodus" />
          </when>

          <!-- On/Off scenes -->
          <when test="6 8 12">
            <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%ID+50%_R-%TT%%CC%%ID+50%01" IndentLevel="2" HelpContext="IOHC-Szenenzustand" />
          </when>
        </choose>
      </when>
    </choose>
  </Dynamic>

</KNX>
