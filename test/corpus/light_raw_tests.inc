// Class B: application payloads from issue #156, not serialized RF frames.
// Source and unchanged original observations: rs100-light-event-vectors-2026-11-05.json
TEST(protocol_light_raw_published_payloads_and_schema)
{
    struct Row { uint8_t data[10]; uint16_t expected; };
    const Row rows[]={
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x01,0x18,0xB9},280},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x01,0x55,0xB9},341},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x01,0xA7,0xB9},423},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x01,0xF8,0xB9},504},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x02,0x5E,0xB9},606},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x02,0x82,0xB9},642},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x02,0x96,0xB9},662},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x02,0x73,0xB9},627},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x02,0x4A,0xB9},586},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x19,0xB9},25},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x0F,0xB9},15},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x05,0xB9},5},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x00,0xB9},0},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x00,0xB9},0},
        {{0x05,0x60,0x20,0x05,0x05,0x06,0x00,0x00,0x00,0xB9},0},
    };
    for(const auto &row:rows){IoHomeLocalSensorEvent value;
        ASSERT_TRUE(IoHomeLocalSensorEvent::decode(IoHomeCommand::StatusUpdate,row.data,10,value));
        ASSERT_EQ(value.raw,row.expected);ASSERT_EQ(value.auxiliary,0xB9);
    }
    uint8_t data[]={5,0x60,0x20,5,5,6,0,2,0x96,0};IoHomeLocalSensorEvent value;
    for(unsigned aux=0;aux<256;++aux){data[9]=aux;ASSERT_TRUE(IoHomeLocalSensorEvent::decode(IoHomeCommand::StatusUpdate,data,10,value));ASSERT_EQ(value.raw,662);ASSERT_EQ(value.auxiliary,aux);}
    for(unsigned length=0;length<24;++length)if(length!=10)ASSERT_TRUE(!IoHomeLocalSensorEvent::decode(IoHomeCommand::StatusUpdate,data,length,value));
    for(unsigned index:{2,3,4,5,6}){data[index]^=1;ASSERT_TRUE(!IoHomeLocalSensorEvent::decode(IoHomeCommand::StatusUpdate,data,10,value));data[index]^=1;}
    ASSERT_TRUE(!IoHomeLocalSensorEvent::decode(IoHomeCommand::PrivateResponse,data,10,value));
    ASSERT_TRUE(!IoHomeLocalSensorEvent::decode(IoHomeCommand::StatusUpdate,nullptr,10,value));
}

#include "protocol/IoHomeEventSubscriptionPlan.h"
TEST(protocol_light_raw_subscription_plan_does_not_enable_battery_or_unsubscribe)
{
    uint8_t data[3]={0xAA,0xAA,0xAA};
    ASSERT_TRUE(ioHomeBuildLightSubscriptionPlan(0x2005,1,data));ASSERT_MEM_EQ(data,"\x01\x20\x05",3);
    for(uint16_t event:{0x100A,0x2001,0x2006})ASSERT_TRUE(!ioHomeBuildLightSubscriptionPlan(event,1,data));
    ASSERT_TRUE(!ioHomeBuildLightSubscriptionPlan(0x2005,0,data));ASSERT_TRUE(!ioHomeBuildLightSubscriptionPlan(0x2005,2,data));
}
